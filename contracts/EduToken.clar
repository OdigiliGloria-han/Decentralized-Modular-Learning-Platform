(define-constant ERR-NOT-AUTHORIZED u401)
(define-constant ERR-INSUFFICIENT-BALANCE u101)
(define-constant ERR-INVALID-AMOUNT u102)
(define-constant ERR-INVALID-RECIPIENT u103)
(define-constant ERR-INVALID-SPENDER u104)
(define-constant ERR-INVALID-OWNER u105)
(define-constant ERR-ALREADY-APPROVED u106)
(define-constant ERR-MINT-LIMIT-EXCEEDED u107)
(define-constant ERR-PAUSED u108)
(define-constant ERR-NOT-PAUSED u109)
(define-constant ERR-BLACKLISTED u110)
(define-constant ERR-INVALID-DECIMALS u111)
(define-constant ERR-INVALID-SYMBOL u112)
(define-constant ERR-INVALID-NAME u113)
(define-constant ERR-TRANSFER-FAILED u114)
(define-constant ERR-BURN-FAILED u115)
(define-constant ERR-MINT-FAILED u116)
(define-constant ERR-APPROVAL-FAILED u117)
(define-constant ERR-INVALID-MINTER u118)
(define-constant ERR-MAX-SUPPLY-REACHED u119)
(define-constant ERR-INVALID-PARAM u120)
(define-constant CONTRACT-OWNER tx-sender)
(define-constant MAX-SUPPLY u1000000000000000)
(define-constant TOKEN-NAME "EduToken")
(define-constant TOKEN-SYMBOL "EDU")
(define-constant TOKEN-DECIMALS u6)
(define-data-var contract-paused bool false)
(define-data-var total-supply uint u0)
(define-data-var minter principal CONTRACT-OWNER)
(define-map balances principal uint)
(define-map allowances {owner: principal, spender: principal} uint)
(define-map blacklist principal bool)
(define-trait fungible-token
  (
    (transfer (uint principal principal (optional (buff 34))) (response bool uint))
    (get-name () (response (string-ascii 32) uint))
    (get-symbol () (response (string-ascii 32) uint))
    (get-decimals () (response uint uint))
    (get-balance (principal) (response uint uint))
    (get-total-supply () (response uint uint))
    (get-token-uri () (response (optional (string-utf8 256)) uint))
  )
)
(define-private (is-owner)
  (is-eq tx-sender CONTRACT-OWNER)
)
(define-private (is-minter)
  (is-eq tx-sender (var-get minter))
)
(define-private (is-paused)
  (var-get contract-paused)
)
(define-private (is-blacklisted (user principal))
  (default-to false (map-get? blacklist user))
)
(define-private (validate-amount (amount uint))
  (if (> amount u0)
    (ok true)
    (err ERR-INVALID-AMOUNT)
  )
)
(define-private (validate-principal (p principal))
  (if (not (is-eq p 'SP000000000000000000002Q6VF78))
    (ok true)
    (err ERR-INVALID-PARAM)
  )
)
(define-private (validate-transfer (sender principal) (recipient principal) (amount uint))
  (begin
    (try! (validate-principal sender))
    (try! (validate-principal recipient))
    (try! (validate-amount amount))
    (asserts! (not (is-blacklisted sender)) (err ERR-BLACKLISTED))
    (asserts! (not (is-blacklisted recipient)) (err ERR-BLACKLISTED))
    (asserts! (not (is-paused)) (err ERR-PAUSED))
    (ok true)
  )
)
(define-private (update-balance (user principal) (amount uint) (increase bool))
  (let (
    (current (default-to u0 (map-get? balances user)))
  )
    (if increase
      (map-set balances user (+ current amount))
      (map-set balances user (- current amount))
    )
  )
)
(define-read-only (get-name)
  (ok TOKEN-NAME)
)
(define-read-only (get-symbol)
  (ok TOKEN-SYMBOL)
)
(define-read-only (get-decimals)
  (ok TOKEN-DECIMALS)
)
(define-read-only (get-balance (account principal))
  (ok (default-to u0 (map-get? balances account)))
)
(define-read-only (get-total-supply)
  (ok (var-get total-supply))
)
(define-read-only (get-token-uri)
  (ok none)
)
(define-read-only (get-allowance (owner principal) (spender principal))
  (ok (default-to u0 (map-get? allowances {owner: owner, spender: spender})))
)
(define-read-only (get-minter)
  (ok (var-get minter))
)
(define-read-only (is-contract-paused)
  (ok (is-paused))
)
(define-public (transfer (amount uint) (sender principal) (recipient principal) (memo (optional (buff 34))))
  (begin
    (asserts! (is-eq tx-sender sender) (err ERR-NOT-AUTHORIZED))
    (try! (validate-transfer sender recipient amount))
    (let (
      (balance-sender (unwrap! (get-balance sender) (err ERR-INSUFFICIENT-BALANCE)))
    )
      (asserts! (>= balance-sender amount) (err ERR-INSUFFICIENT-BALANCE))
      (update-balance sender amount false)
      (update-balance recipient amount true)
      (print {event: "transfer", from: sender, to: recipient, amount: amount, memo: memo})
      (ok true)
    )
  )
)
(define-public (transfer-from (amount uint) (owner principal) (recipient principal))
  (let (
    (allowance (unwrap! (get-allowance owner tx-sender) (err ERR-INVALID-SPENDER)))
  )
    (asserts! (>= allowance amount) (err ERR-INSUFFICIENT-BALANCE))
    (try! (validate-transfer owner recipient amount))
    (let (
      (balance-owner (unwrap! (get-balance owner) (err ERR-INSUFFICIENT-BALANCE)))
    )
      (asserts! (>= balance-owner amount) (err ERR-INSUFFICIENT-BALANCE))
      (map-set allowances {owner: owner, spender: tx-sender} (- allowance amount))
      (update-balance owner amount false)
      (update-balance recipient amount true)
      (print {event: "transfer-from", owner: owner, spender: tx-sender, to: recipient, amount: amount})
      (ok true)
    )
  )
)
(define-public (approve (spender principal) (amount uint))
  (begin
    (try! (validate-principal spender))
    (try! (validate-amount amount))
    (asserts! (not (is-paused)) (err ERR-PAUSED))
    (map-set allowances {owner: tx-sender, spender: spender} amount)
    (print {event: "approve", owner: tx-sender, spender: spender, amount: amount})
    (ok true)
  )
)
(define-public (increase-allowance (spender principal) (amount uint))
  (let (
    (current (default-to u0 (map-get? allowances {owner: tx-sender, spender: spender})))
  )
    (try! (approve spender (+ current amount)))
    (ok true)
  )
)
(define-public (decrease-allowance (spender principal) (amount uint))
  (let (
    (current (default-to u0 (map-get? allowances {owner: tx-sender, spender: spender})))
  )
    (asserts! (>= current amount) (err ERR-INSUFFICIENT-BALANCE))
    (try! (approve spender (- current amount)))
    (ok true)
  )
)
(define-public (mint (amount uint) (recipient principal))
  (begin
    (asserts! (is-minter) (err ERR-NOT-AUTHORIZED))
    (try! (validate-amount amount))
    (try! (validate-principal recipient))
    (asserts! (not (is-blacklisted recipient)) (err ERR-BLACKLISTED))
    (let (
      (new-supply (+ (var-get total-supply) amount))
    )
      (asserts! (<= new-supply MAX-SUPPLY) (err ERR-MAX-SUPPLY-REACHED))
      (update-balance recipient amount true)
      (var-set total-supply new-supply)
      (print {event: "mint", to: recipient, amount: amount})
      (ok true)
    )
  )
)
(define-public (burn (amount uint))
  (begin
    (try! (validate-amount amount))
    (asserts! (not (is-paused)) (err ERR-PAUSED))
    (let (
      (balance (unwrap! (get-balance tx-sender) (err ERR-INSUFFICIENT-BALANCE)))
    )
      (asserts! (>= balance amount) (err ERR-INSUFFICIENT-BALANCE))
      (update-balance tx-sender amount false)
      (var-set total-supply (- (var-get total-supply) amount))
      (print {event: "burn", from: tx-sender, amount: amount})
      (ok true)
    )
  )
)
(define-public (burn-from (amount uint) (owner principal))
  (begin
    (try! (transfer-from amount owner tx-sender))
    (try! (burn amount))
    (ok true)
  )
)
(define-public (set-minter (new-minter principal))
  (begin
    (asserts! (or (is-owner) (is-minter)) (err ERR-NOT-AUTHORIZED))
    (try! (validate-principal new-minter))
    (var-set minter new-minter)
    (print {event: "set-minter", new-minter: new-minter})
    (ok true)
  )
)
(define-public (pause-contract)
  (begin
    (asserts! (is-owner) (err ERR-NOT-AUTHORIZED))
    (asserts! (not (is-paused)) (err ERR-NOT-PAUSED))
    (var-set contract-paused true)
    (print {event: "pause"})
    (ok true)
  )
)
(define-public (unpause-contract)
  (begin
    (asserts! (is-owner) (err ERR-NOT-AUTHORIZED))
    (asserts! (is-paused) (err ERR-PAUSED))
    (var-set contract-paused false)
    (print {event: "unpause"})
    (ok true)
  )
)
(define-public (add-to-blacklist (user principal))
  (begin
    (asserts! (is-owner) (err ERR-NOT-AUTHORIZED))
    (try! (validate-principal user))
    (map-set blacklist user true)
    (print {event: "blacklist-add", user: user})
    (ok true)
  )
)
(define-public (remove-from-blacklist (user principal))
  (begin
    (asserts! (is-owner) (err ERR-NOT-AUTHORIZED))
    (map-delete blacklist user)
    (print {event: "blacklist-remove", user: user})
    (ok true)
  )
)
(define-fungible-token edu-token MAX-SUPPLY)